# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database - PostgreSQL
# ------------------------------------------------------------------------------
DB_NAME=receiptflow
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis + Celery (Async Processing)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
PROCESSING_TIMEOUT_MINUTES=15
PROCESSING_MAX_ATTEMPTS=3
CELERY_BEAT_ENABLED=True

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATELIMIT_ENABLE=True
RATELIMIT_AUTH_LOGIN=10/m
RATELIMIT_AUTH_REGISTER=5/m
RATELIMIT_AUTH_PASSWORD_RESET=5/m
RATELIMIT_AUTH_VERIFY_EMAIL=10/m
RATELIMIT_DOCUMENTS_CREATE=20/m
RATELIMIT_DOCUMENTS_PROCESS=15/m

# ------------------------------------------------------------------------------
# Storage (filesystem | gcs)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=filesystem
GS_BUCKET_NAME=your-receiptflow-bucket
GS_PROJECT_ID=your-google-cloud-project-id
GS_DEFAULT_ACL=private
GS_CACHE_CONTROL=public, max-age=3600

# ------------------------------------------------------------------------------
# Google Cloud Vision API (opcional si usas Gemini)
# ------------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
GOOGLE_VISION_TIMEOUT=60

# ------------------------------------------------------------------------------
# Google Gemini AI — OCR inteligente de documentos (recomendado)
# Obtén tu API Key en: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
# Opciones: gemini | google_vision
OCR_SERVICE=gemini


# ------------------------------------------------------------------------------
# CORS - Frontend Next.js
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Email (for password reset & email verification)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL="ReceiptFlow <no-reply@receiptflow.com>"

# ------------------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# File Uploads
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,bmp,tiff,pdf
ALLOWED_DOCUMENT_EXTENSIONS=pdf,jpg,jpeg,png

# ------------------------------------------------------------------------------
# App
# ------------------------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_REQUIRED=True
